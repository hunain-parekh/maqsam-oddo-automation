MAQSAM_BASE_URL=your-base-url-from-maqsam
MAQSAM_ACCESS_KEY_ID=your-maqsam-access-key-id
MAQSAM_ACCESS_SECRET=your-maqsam-access-secret

ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=api-user@example.com
ODOO_API_KEY=your-odoo-api-key

# Recommended: create this custom field on crm.lead in Odoo.
# Leave blank to rely only on local state-file dedupe.
ODOO_MAQSAM_ID_FIELD=x_maqsam_call_id

# Optional tuning.
SYNC_STATE_FILE=data/state.json
# First run defaults to importing the latest Maqsam page without date filters.
# This imports up to 100 latest calls, then future runs use start_time/end_time.
SYNC_FIRST_RUN_MODE=latest_page
SYNC_INITIAL_IMPORT_PAGES=1
# Used only when SYNC_FIRST_RUN_MODE=lookback.
SYNC_INITIAL_LOOKBACK_SECONDS=86400
SYNC_OVERLAP_SECONDS=300
SYNC_END_DELAY_SECONDS=60
SYNC_MAX_PAGES=100
SYNC_PROCESSED_ID_RETENTION_SECONDS=604800
SYNC_DRY_RUN=false

# Optional Odoo assignment.
ODOO_LEAD_TYPE=lead
# ODOO_TEAM_ID=
# ODOO_USER_ID=
